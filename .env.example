# Kopiera till .env.local och fyll i lokalt. Dela inte nycklar i chatten.
# .env.local ignoreras av Git. Dessa variabler ar endast for servern.
# Filen maste lasas av en backend/testprocess; Vite dev kor bara frontend.

# Terminalens eget inloggningslosenord, inte ett konto-/banklosenord.
APP_LOGIN_PASSWORD=""
ANTHROPIC_API_KEY=""
TWELVE_DATA_API_KEY=""
SUPABASE_URL=""
# Supabase servernyckel: sb_secret_... eller aldre service_role JWT.
SUPABASE_SECRET_KEY=""

# Valfri separat projektatkomst for deployment respektive SQL-administration.
# Anvand verktygets lokala inloggning eller fyll i en tidsbegransad token.
# VERCEL_TOKEN=""
# VERCEL_PROJECT_ID=""
# VERCEL_ORG_ID=""
# SUPABASE_ACCESS_TOKEN=""
# SUPABASE_PROJECT_REF=""

# Aktivera endast for en separat testdatabas i Vercel Preview.
# PREVIEW_ALLOW_WRITES="true"
